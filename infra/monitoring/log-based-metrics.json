{
  "metrics": [
    {
      "name": "contact_form_ses_delivery_failure_count",
      "filter": "resource.type=\"cloud_run_revision\" AND resource.labels.service_name=\"${SERVICE_NAME}\" AND jsonPayload.event=\"ses_delivery_failure\""
    },
    {
      "name": "contact_form_recaptcha_transport_failure_count",
      "filter": "resource.type=\"cloud_run_revision\" AND resource.labels.service_name=\"${SERVICE_NAME}\" AND jsonPayload.event=\"recaptcha_transport_failure\""
    }
  ]
}
