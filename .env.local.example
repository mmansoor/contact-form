CONTACT_API_SECRET=replace-with-contact-route-secret
CONTRACT_DOCS_SECRET=replace-with-docs-route-secret
RECAPTCHA_SECRET=replace-with-recaptcha-secret
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=replace-with-local-iam-access-key-id
AWS_SECRET_ACCESS_KEY=replace-with-local-iam-secret-access-key
CONTACT_FROM_EMAIL=noreply@example.com
CONTACT_TO_EMAIL=info@example.com
# Optional per-tenant admin recipients (fall back to CONTACT_TO_EMAIL when unset):
# CONTACT_TO_EMAIL_DONORNODE=
# CONTACT_TO_EMAIL_CLOUDVANTAGE=
# CONTACT_TO_EMAIL_WWT=
SES_ADMIN_TEMPLATE=contact-form-admin-notification-v2
SES_CONFIRMATION_TEMPLATE=contact-form-confirmation-v2
PORT=8080
RECAPTCHA_VERIFY_URL=https://www.google.com/recaptcha/api/siteverify
SERVICE_BASE_URL=https://contact-form.example.com
BRAND_COMPANY_NAME=Web Wire Technologies
BRAND_SITE_NAME=WWT
BRAND_DOMAIN=wwt.co
BRAND_URL=https://wwt.co
BRAND_SUPPORT_EMAIL=info@wwt.co
BRAND_TEAM_NAME=Web Wire Technologies Team
BRAND_PRIVACY_URL=https://wwt.co/privacy
BRAND_TERMS_URL=https://wwt.co/terms
# ── Configurable v2 contact API (opt-in) ──────────────────────────────
# Leave CONTACT_FORM_CONFIG_SOURCE unset to keep v2 dormant.
# Set to "file" for local dev:
# CONTACT_FORM_CONFIG_SOURCE=file
# CONTACT_FORM_CONFIG_FILE=config/contact-form-routing-config.sample.json
# Or "env" to inline the JSON:
# CONTACT_FORM_CONFIG_SOURCE=env
# CONTACT_FORM_CONFIG_JSON={"version":"2026-01-01","sites":[{"id":"local","originRules":[{"type":"exact","value":"http://localhost:3000"}],"email":{"to":["test@example.com"}}]}
# Or "secret-manager" in Cloud Run:
# CONTACT_FORM_CONFIG_SOURCE=secret-manager
# CONTACT_FORM_CONFIG_SECRET_NAME=contact-form-routing-config
# CONTACT_FORM_CONFIG_PROJECT_ID=contact-form-495912
