{
  "TemplateName": "contact-form-admin-notification-v2",
  "TemplateContent": {
    "Subject": "[{{#if brand_site_name}}{{brand_site_name}}{{else}}Contact{{/if}}] {{subject}}",
    "Text": "Name: {{name}}\nEmail: {{email}}\nCompany: {{company}}\nPhone: {{phone}}\nInquiry Type: {{inquiry_type}}\nSubmitted: {{timestamp}}\nSubject: {{subject}}\n\nMessage:\n{{message}}",
    "Html": "<div style=\"font-family:Arial,Helvetica,sans-serif;font-size:13px;color:#333\"><table cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"width:100%;border-collapse:collapse\"><tr><td style=\"padding:4px 12px 4px 0;font-weight:600;color:#666;white-space:nowrap\">Name</td><td style=\"padding:4px 24px 4px 0\">{{name}}</td><td style=\"padding:4px 12px 4px 0;font-weight:600;color:#666;white-space:nowrap\">Email / Reply To</td><td style=\"padding:4px 0\">{{email}}</td></tr><tr><td style=\"padding:4px 12px 4px 0;font-weight:600;color:#666;white-space:nowrap\">Company</td><td style=\"padding:4px 24px 4px 0\">{{company}}</td><td style=\"padding:4px 12px 4px 0;font-weight:600;color:#666;white-space:nowrap\">Phone</td><td style=\"padding:4px 0\">{{phone}}</td></tr><tr><td style=\"padding:4px 12px 4px 0;font-weight:600;color:#666;white-space:nowrap\">Inquiry Type</td><td style=\"padding:4px 24px 4px 0\">{{inquiry_type}}</td><td style=\"padding:4px 12px 4px 0;font-weight:600;color:#666;white-space:nowrap\">Submitted</td><td style=\"padding:4px 0\">{{timestamp}}</td></tr><tr><td style=\"padding:4px 12px 4px 0;font-weight:600;color:#666;white-space:nowrap\">Subject</td><td colspan=\"3\" style=\"padding:4px 0\">{{subject}}</td></tr><tr><td style=\"padding:4px 12px 8px 0;font-weight:600;color:#666;white-space:nowrap;vertical-align:top\">Message</td><td colspan=\"3\" style=\"padding:4px 0 8px\">{{message}}</td></tr></table></div>"
  }
}
