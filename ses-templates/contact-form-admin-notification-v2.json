{
  "TemplateName": "contact-form-admin-notification-v2",
  "TemplateContent": {
    "Subject": "[{{#if brand_site_name}}{{brand_site_name}}{{else}}Contact{{/if}}] {{subject}}",
    "Html": "<!DOCTYPE html><html lang=\"en\"><head><meta charset=\"UTF-8\"><meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\"><title>Contact Form Submission</title><style>body{font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Oxygen,Ubuntu,sans-serif;line-height:1.5;color:#333;background-color:#f4f4f4;margin:0;padding:20px}.container{max-width:600px;margin:0 auto;background-color:#fff;border-radius:8px;overflow:hidden;box-shadow:0 2px 8px rgba(0,0,0,.1)}.header{background:linear-gradient(135deg,#2563eb 0%,#1d4ed8 100%);color:#fff;padding:15px}.content{padding:15px}.info-table{width:100%;border-collapse:collapse}.info-table td{padding:5px 8px;border-bottom:1px solid #f3f4f6;vertical-align:top}.info-table td.label{font-weight:600;color:#6b7280;white-space:nowrap;width:90px}.info-table td.value{color:#1f2937}.info-table td.value a{color:#2563eb;text-decoration:none}.message-box{background-color:#f9fafb;padding:12px;border-radius:6px;border-left:4px solid #2563eb;margin:8px 0}.message-box p{margin:0;white-space:pre-wrap}.footer{background-color:#1f2937;color:#d1d5db;text-align:center;padding:8px;font-size:12px}.footer a{color:#60a5fa;text-decoration:none}</style></head><body><div class=\"container\"><div class=\"header\"></div><div class=\"content\"><table class=\"info-table\"><tr><td class=\"label\">Name</td><td class=\"value\">{{name}}</td><td class=\"label\">Email / Reply To</td><td class=\"value\">{{email}}</td></tr><tr><td class=\"label\">Company</td><td class=\"value\">{{company}}</td><td class=\"label\">Phone</td><td class=\"value\">{{phone}}</td></tr><tr><td class=\"label\">Inquiry Type</td><td class=\"value\">{{inquiry_type}}</td><td class=\"label\">Submitted</td><td class=\"value\">{{timestamp}}</td></tr><tr><td class=\"label\">Subject</td><td class=\"value\" colspan=\"3\">{{subject}}</td></tr><tr><td class=\"label\" style=\"vertical-align:top\">Message</td><td class=\"value\" colspan=\"3\"><div class=\"message-box\"><p>{{message}}</p></div></td></tr></table></div><div class=\"footer\"><a href=\"{{#if brand_url}}{{brand_url}}{{else}}https://cloudvantage.co{{/if}}\">{{#if brand_url}}{{brand_url}}{{else}}https://cloudvantage.co{{/if}}</a></div></div></body></html>"
  }
}
