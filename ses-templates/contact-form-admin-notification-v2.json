{
  "TemplateName": "contact-form-admin-notification-v2",
  "TemplateContent": {
    "Subject": "[{{#if brand_site_name}}{{brand_site_name}}{{else}}CloudVantage{{/if}}] New Contact: {{subject}}",
    "Text": "New contact form submission\n\nSource: {{source_domain}}\nReference: {{timestamp}}\n\nName: {{name}}\nEmail: {{email}}\nPhone: {{phone}}\nCompany: {{company}}\nSubject: {{subject}}\nInquiry Type: {{inquiry_type}}\nIP Address: {{ip_address}}\n\nMessage:\n{{message}}\n\n{{#if brand_company_name}}This notification was sent by {{brand_company_name}}.{{else}}This notification was sent by CloudVantage.{{/if}}",
    "Html": "<!DOCTYPE html><html lang=\"en\"><head><meta charset=\"UTF-8\"><meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\"><title>New Contact Form Submission</title><style>body{font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Oxygen,Ubuntu,sans-serif;line-height:1.6;color:#333;background-color:#f4f4f4;margin:0;padding:20px}.container{max-width:600px;margin:0 auto;background-color:#fff;border-radius:8px;overflow:hidden;box-shadow:0 2px 8px rgba(0,0,0,.1)}.header{background:linear-gradient(135deg,#2563eb 0%,#1d4ed8 100%);color:#fff;padding:30px;text-align:center}.header h1{margin:0;font-size:24px;font-weight:600}.header p{margin:10px 0 0;opacity:.9;font-size:14px}.content{padding:30px}.alert-box{background-color:#eff6ff;border-left:4px solid #2563eb;padding:15px;margin-bottom:25px;border-radius:4px}.alert-box p{margin:0;color:#1e40af}.info-section{margin-bottom:25px}.info-section h3{color:#1f2937;font-size:18px;margin-bottom:15px;padding-bottom:10px;border-bottom:2px solid #e5e7eb}.field-grid{display:grid;grid-template-columns:140px 1fr;gap:10px;margin-bottom:10px}.field-label{font-weight:600;color:#6b7280}.field-value{color:#1f2937}.field-value a{color:#2563eb;text-decoration:none}.message-box{background-color:#f9fafb;padding:20px;border-radius:6px;border-left:4px solid #2563eb;margin:20px 0}.message-box p{margin:0;white-space:pre-wrap;font-style:italic}.metadata{font-size:12px;color:#6b7280;margin-top:30px;padding-top:20px;border-top:1px solid #e5e7eb}.metadata p{margin:5px 0}.footer{background-color:#1f2937;color:#d1d5db;text-align:center;padding:20px;font-size:12px}.footer a{color:#60a5fa;text-decoration:none}</style></head><body><div class=\"container\"><div class=\"header\"><h1>New Contact Form Submission</h1><p>Someone wants to get in touch</p></div><div class=\"content\"><div class=\"alert-box\"><p><strong>Source:</strong> {{source_domain}} &nbsp;|&nbsp; <strong>Reference:</strong> {{timestamp}}</p></div><div class=\"info-section\"><h3>Contact Information</h3><div class=\"field-grid\"><div class=\"field-label\">Name:</div><div class=\"field-value\">{{name}}</div></div><div class=\"field-grid\"><div class=\"field-label\">Email:</div><div class=\"field-value\"><a href=\"mailto:{{email}}\">{{email}}</a></div></div><div class=\"field-grid\"><div class=\"field-label\">Phone:</div><div class=\"field-value\">{{phone}}</div></div><div class=\"field-grid\"><div class=\"field-label\">Company:</div><div class=\"field-value\">{{company}}</div></div><div class=\"field-grid\"><div class=\"field-label\">Subject:</div><div class=\"field-value\">{{subject}}</div></div><div class=\"field-grid\"><div class=\"field-label\">Inquiry Type:</div><div class=\"field-value\">{{inquiry_type}}</div></div></div><div class=\"info-section\"><h3>Message</h3><div class=\"message-box\"><p>{{message}}</p></div></div><div class=\"metadata\"><p><strong>Submitted:</strong> {{timestamp}}</p><p><strong>Source IP:</strong> {{ip_address}}</p><p><strong>Email Reply To:</strong> {{email}}</p></div></div><div class=\"footer\"><p>{{#if brand_company_name}}This email was sent by {{brand_company_name}}.{{else}}This email was sent by CloudVantage.{{/if}}</p><p style=\"margin-top:10px;\">{{#if brand_url}}<a href=\"{{brand_url}}\">{{brand_url}}</a>{{else}}<a href=\"https://cloudvantage.co\">https://cloudvantage.co</a>{{/if}}</p></div></div></body></html>"
  }
}
